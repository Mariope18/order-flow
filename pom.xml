<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. Coordinate del Root Project -->
    <groupId>com.orderflow</groupId>
    <artifactId>order-flow</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OrderFlow</name>
    <description>Enterprise Event-Driven Distributed Microservices Platform</description>

    <!-- 2. Proprietà Globali -->
    <!-- 2. Proprietà Globali -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Stack Versions -->
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <!-- 3. Dependency Management: Catalogo centralizzato delle versioni -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM (Importa tutte le versioni ufficiali senza ereditarietà rigida) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 4. Plugin Management: Standardizzazione del ciclo di build per tutti i moduli -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Compilatore Java 21 con flag -parameters per Spring -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <!-- Fondamentale per Spring: mantiene i nomi dei parametri dei metodi (usato per @PathVariable, record, ecc.) -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <!-- Runner Test JUnit 5 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>

                <!-- Plugin Spring Boot per impacchettare i microservizi eseguibili -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 4. Moduli (per ora vuoto, aggiungeremo orderflow-common) -->
    <modules>
        <module>orderflow-common</module>
    </modules>

</project>